<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".MainActivity">

    <!-- Baris 1 -->
    <Button
        android:id="@+id/button_browser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_browser" />

    <Button
        android:id="@+id/button_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_toRightOf="@id/button_browser"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_toast" />

    <Button
        android:id="@+id/button_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_toRightOf="@id/button_toast"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_count" />

    <Button
        android:id="@+id/button_switchpage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_toRightOf="@id/button_count"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_pindah" />

    <!-- Baris 2 -->
    <Button
        android:id="@+id/button_map"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_browser"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_map" />

    <Button
        android:id="@+id/button_contact"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_browser"
        android:layout_marginLeft="20dp"
        android:layout_toRightOf="@id/button_map"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_contact" />

    <Button
        android:id="@+id/button_dial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_browser"
        android:layout_marginLeft="20dp"
        android:layout_toRightOf="@id/button_contact"
        android:backgroundTint="@color/warnabiru"
        android:text="@string/button_label_dial" />

    <TextView
        android:id="@+id/show_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/button_map"
        android:layout_marginTop="20dp"
        android:background="#FFFF00"
        android:gravity="center"
        android:text="@string/count_initial_value"
        android:textSize="80sp" />
</RelativeLayout>